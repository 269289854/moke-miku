{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Moke host capabilities, limited to the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:read-files",
      "allow": [
        {
          "path": "$APPCACHE/moke-http-cache/**"
        }
      ]
    },
    {
      "identifier": "fs:read-dirs",
      "allow": [
        {
          "path": "$APPCACHE/moke-http-cache"
        },
        {
          "path": "$APPCACHE/moke-http-cache/**"
        }
      ]
    },
    {
      "identifier": "fs:write-all",
      "allow": [
        {
          "path": "$APPCACHE/moke-http-cache"
        },
        {
          "path": "$APPCACHE/moke-http-cache/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/books"
        },
        {
          "path": "$APPDATA/books/**"
        },
        {
          "path": "$APPCACHE/moke-http-cache"
        },
        {
          "path": "$APPCACHE/moke-http-cache/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    "fs:allow-read",
    "fs:allow-seek",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    "fs:allow-ftruncate",
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$APPDATA/books/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**:**"
        },
        {
          "url": "https://**:**"
        }
      ]
    },
    "os:default",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "native-bridge:allow-set-secure-item",
    "native-bridge:allow-get-secure-item",
    "native-bridge:allow-clear-secure-item",
    "allow-moke-runtime-platform",
    "allow-moke-navigate",
    "allow-moke-record-downloaded-book",
    "allow-moke-delete-downloaded-book-file",
    "allow-moke-open-downloaded-book",
    "allow-moke-reveal-downloaded-book",
    "allow-moke-remove-downloaded-book",
    "allow-moke-select-download-directory",
    "allow-moke-reset-download-directory",
    "allow-moke-get-download-directory",
    "allow-moke-download-storage-stats",
    "allow-moke-list-downloaded-books",
    "allow-moke-get-reader-cache-stats",
    "allow-moke-clear-reader-cache",
    "allow-open-reader"
  ]
}
